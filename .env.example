# ============================================================================
# MARKETING GENIE — environment variables
# Copy the ones you need into Vercel (Project → Settings → Environment Variables)
# and, for local dev, into a .env.local file. Grouped by TIER: do Tier 0 and 1
# first — that's the minimum to log in and have the engine actually work.
# ============================================================================

# ── TIER 0 — BOOT & LOGIN (nothing works without these) ─────────────────────
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; powers cron/background jobs

# Your deployed origin (no trailing slash). Used for links, cron callbacks,
# job fan-out. Falls back to the hardcoded vercel URL if unset — set it anyway.
APP_URL=https://thegenieofmarketing.vercel.app
# The same address, readable in the browser. Used for links the pages themselves
# build. UNSET: falls back to APP_URL where it can.
NEXT_PUBLIC_APP_URL=https://thegenieofmarketing.vercel.app
# Shown to a signed-in owner when something needs a human. UNSET: no address shown.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── TIER 1 — THE BRAIN + THE NIGHTLY ENGINE ─────────────────────────────────
# At least ONE AI provider is REQUIRED (content, keywords, chat all use it).
# Gemini and Groq have generous FREE tiers — easiest place to start.
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey (free)
# GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=                         # https://console.groq.com (free)
# GROQ_MODEL=
OPENROUTER_API_KEY=                   # optional alternative
# OPENROUTER_MODEL=
# More free tiers. Each one the router can reach is one more provider before the
# crowd has to drop to its quick rules-based check instead of a full-size test.
# MISTRAL_API_KEY=                    # https://console.mistral.ai (free tier)
# MISTRAL_MODEL=
# CEREBRAS_API_KEY=                   # https://cloud.cerebras.ai (free tier)
# CEREBRAS_MODEL=
# CLOUDFLARE_ACCOUNT_ID=              # Workers AI needs both of these
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_MODEL=
# Every *_MODEL above is an override. Leave them unset unless a provider retires a
# model — the router's defaults are the ones it has been tested against.
# GEMINI_SEARCH_MODEL=                # the model used for grounded web search
# GROQ_WHISPER_MODEL=                 # transcribing an uploaded video
# OPENROUTER_PAID_MODEL=              # default qwen/qwen3-235b-a22b-2507

# ── PAYING FOR THE WRITING, WHICH IS OPTIONAL ──
# Two independent routes, and WRITER_PROVIDERS below decides which is tried first.
#  · openrouter-paid uses the OPENROUTER_API_KEY above against a paid model, so it
#    needs credit on that OpenRouter account. Set OPENROUTER_PAID_DISABLED=true to
#    make sure Genie never spends it.
#  · PAID_LLM_API_KEY is any OpenAI-compatible paid endpoint (OpenAI, Together,
#    Groq paid, …). Note the name: it is PAID_LLM_API_KEY, not PAID_LLM_KEY.
# Neither is required. The default writer list ends in `gemini`, which is free, so
# articles and cold emails are written either way — paying only makes them better.
# PAID_LLM_API_KEY=                   # optional paid fallback (OpenAI-compatible)
# PAID_LLM_MODEL=                     # default gpt-4o-mini
# PAID_LLM_BASE=                      # default https://api.openai.com/v1
# PAID_DAILY_USD=                     # daily spend cap. UNSET: $0.30/day
# OPENROUTER_PAID_DISABLED=           # true = never spend OpenRouter credit
# SWARM_ALLOW_PAID=                   # true = let the crowd use paid models too

# Required for the nightly engine (Vercel injects this header into cron calls)
# AND for internal job/queue auth. Generate any long random string.
# It also signs which photos the social-card composer may fetch (lib/card-sign.js).
# UNSET: the nightly engine refuses to run, and every social card renders its
# branded panel instead of the photo — degraded, but never an open image proxy.
CRON_SECRET=

# Which providers are good enough to write something a BUYER reads (the cold
# email and the article). Comma-separated, in the router's own names.
# UNSET: defaults to paid,openrouter-paid,gemini. When none of them is free, Genie
# writes nothing that night rather than dropping to a weaker model — a flat email
# on Friday teaches the owner that Genie got worse, and they stop sending.
WRITER_PROVIDERS=

# ── HOW LONG THIS HOST LETS A FUNCTION RUN ──
# `export const maxDuration` is a request, not a guarantee: Vercel Hobby stops any
# function at 60 seconds whatever a route declares, with no error and no log. So
# Genie reads the real limit from here and trims what it attempts to fit — the
# longest articles come out shorter, the nightly run hands work off instead of
# waiting for it, and the crowd stops itself in time.
# UNSET: assumes 60, which is right for Hobby and for most free hosts.
# Set it to 300 the day you move to Vercel Pro and every shortened thing returns to
# full size with no code change.
# FUNCTION_MAX_SECONDS=300

# ── THE CROWD'S HEARTBEAT (free, and worth doing) ──
# Its own secret, never CRON_SECRET, because CRON_SECRET also signs image links.
# Set the SAME value here and as a GitHub Actions secret, plus an Actions variable
# GENIE_URL = your site's address (repo Settings -> Secrets and variables).
# UNSET: the crowd only tests drafts during the nightly run. With it, .github/
# workflows/genie-heartbeat.yml asks for a pass, so a draft written at noon is
# tested the same afternoon and work the free AI was too busy for is picked up as
# soon as it is back. GitHub Actions minutes are free on a public repo.
# It asks for every ten minutes and GitHub delivers about seven a day on free shared
# runners — measured, not assumed. Still far better than once a night.
HEARTBEAT_SECRET=

# ── TIER 2 — ACT: publish, email, connect accounts ──────────────────────────
# Email (outreach + the daily brief). Resend account + a verified domain.
RESEND_API_KEY=
# BRIEF_FROM     — system mail Genie sends to ITS OWN user (daily brief, alerts).
#                  A Genie-owned, Resend-verified address is correct here.
#                  e.g. "Marketing Genie <hello@yourgeniedomain.com>"
# OUTREACH_FROM  — cold outreach sent on a CUSTOMER's behalf. Leave this UNSET
#                  unless the address is on a domain you have verified in Resend.
#                  Unset means Genie refuses to send cold email from a shared
#                  address and tells the user to connect Gmail instead, which is
#                  the only way it actually reaches an inbox.
# BRIEF_FROM=
# OUTREACH_FROM=
BRIEF_FROM=Genie <you@yourverifieddomain.com>

# Google connect (Search Console, Analytics, Gmail send, Keyword Planner).
# Create an OAuth client in Google Cloud Console; redirect URI must match below.
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_CONNECT_REDIRECT_URI=https://thegenieofmarketing.vercel.app/api/connect/google/callback

# X (Twitter) connect. Create an app in the X developer portal.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://thegenieofmarketing.vercel.app/api/connect/x/callback

# ── TIER 3 — ENHANCEMENTS (all optional; app degrades gracefully) ───────────
GOOGLE_ADS_DEVELOPER_TOKEN=           # real keyword search volumes (Keyword Planner)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=         # your Ads manager (MCC) customer id
# GOOGLE_ADS_API_VERSION=             # override only if Google retires the current one
PAGESPEED_API_KEY=                    # or GOOGLE_API_KEY — real PageSpeed audits
GOOGLE_API_KEY=
# Reddit buyer discovery — FREE. Create an app (type "script" or "web app") at
# reddit.com/prefs/apps, then paste its id + secret. Reliable from servers where
# Reddit's public JSON is blocked. Without it, Genie falls back to free web search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Reddit buyer hunting: NO API approval needed. Genie reads Reddit via Google's index
# (grounded search, zero config) by default. OPTIONAL: add your personal RSS feed
# token for fresher/direct results (grab user + feed token from a logged-in Reddit RSS
# link, e.g. reddit.com/.rss while signed in — the URL contains ?feed=...&user=...).
REDDIT_RSS_USER=                      # optional — your Reddit username (from an RSS feed link)
REDDIT_RSS_TOKEN=                     # optional — the `feed=` token from that RSS link (lifts the throttle)

# Web search for Find clients / research: primary is Gemini grounded search, which
# reuses GEMINI_API_KEY (above) — no extra key needed. The two below are optional.
BRAVE_SEARCH_API_KEY=                 # optional web search (reliable, but free tier now needs a card)
TAVILY_API_KEY=                       # optional web search (free tier, no card)
SERPAPI_KEY=                          # last-resort paid fallback for Reddit/Quora/web discovery
QSTASH_TOKEN=                         # durable queue (else in-process fan-out)
WEBHOOK_SECRET=                       # commerce webhook token (falls back to CRON_SECRET)

# Hero images for published articles (optional; articles publish text-only without it).
# OpenAI-compatible /images endpoint — set the key to enable. Any compatible host works.
IMAGE_API_KEY=                        # e.g. OpenAI (gpt-image-1). Enables article hero images.
PEXELS_API_KEY=                       # free stock photos, so drafts ship with a real image
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
# IMAGEN_MODEL=imagen-3.0-generate-002  # fallback via your free GEMINI_API_KEY (best-effort)

# Instant indexing (IndexNow) — free, no account. Published Genie Pages get indexed
# by Bing/Yandex in hours (which also feeds ChatGPT/Perplexity search). Generate any
# 16–32 char hex string (e.g. `openssl rand -hex 16`) and paste it here.
INDEXNOW_KEY=

# OPENPAGERANK_API_KEY — free authority scores for link targets, so Genie ranks
#   the sites it finds instead of pitching them blind. Free key, 30,000 domains a
#   month: https://openpagerank.keywordseverywhere.com
#   Unset is fine. Scoring is skipped and every play behaves exactly as before.
OPENPAGERANK_API_KEY=
