# ============================================================================
# MARKETING GENIE — environment variables
# Copy the ones you need into Vercel (Project → Settings → Environment Variables)
# and, for local dev, into a .env.local file. Grouped by TIER: do Tier 0 and 1
# first — that's the minimum to log in and have the engine actually work.
# ============================================================================

# ── TIER 0 — BOOT & LOGIN (nothing works without these) ─────────────────────
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; powers cron/background jobs

# Your deployed origin (no trailing slash). Used for links, cron callbacks,
# job fan-out. Falls back to the hardcoded vercel URL if unset — set it anyway.
APP_URL=https://thegenieofmarketing.vercel.app

# ── TIER 1 — THE BRAIN + THE NIGHTLY ENGINE ─────────────────────────────────
# At least ONE AI provider is REQUIRED (content, keywords, chat all use it).
# Gemini and Groq have generous FREE tiers — easiest place to start.
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey (free)
# GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=                         # https://console.groq.com (free)
# GROQ_MODEL=
OPENROUTER_API_KEY=                   # optional alternative
# OPENROUTER_MODEL=
# PAID_LLM_API_KEY=                   # optional paid fallback (OpenAI-compatible)
# PAID_LLM_MODEL=
# PAID_LLM_BASE=
# PAID_DAILY_USD=                     # daily spend cap for the paid fallback

# Required for the nightly engine (Vercel injects this header into cron calls)
# AND for internal job/queue auth. Generate any long random string.
CRON_SECRET=

# ── TIER 2 — ACT: publish, email, connect accounts ──────────────────────────
# Email (outreach + the daily brief). Resend account + a verified domain.
RESEND_API_KEY=
BRIEF_FROM=Genie <you@yourverifieddomain.com>

# Google connect (Search Console, Analytics, Gmail send, Keyword Planner).
# Create an OAuth client in Google Cloud Console; redirect URI must match below.
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_CONNECT_REDIRECT_URI=https://thegenieofmarketing.vercel.app/api/connect/google/callback

# X (Twitter) connect. Create an app in the X developer portal.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://thegenieofmarketing.vercel.app/api/connect/x/callback

# ── TIER 3 — ENHANCEMENTS (all optional; app degrades gracefully) ───────────
GOOGLE_ADS_DEVELOPER_TOKEN=           # real keyword search volumes (Keyword Planner)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=         # your Ads manager (MCC) customer id
PAGESPEED_API_KEY=                    # or GOOGLE_API_KEY — real PageSpeed audits
GOOGLE_API_KEY=
# Reddit buyer discovery — FREE. Create an app (type "script" or "web app") at
# reddit.com/prefs/apps, then paste its id + secret. Reliable from servers where
# Reddit's public JSON is blocked. Without it, Genie falls back to free web search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

GOOGLE_CSE_ID=                        # Programmable Search engine id (cx) — FREE web search for Find clients (100/day, no card)
GOOGLE_CSE_KEY=                       # optional; falls back to GOOGLE_API_KEY. Custom Search API key
BRAVE_SEARCH_API_KEY=                 # optional web search (reliable, but free tier now needs a card)
SERPAPI_KEY=                          # last-resort paid fallback for Reddit/Quora/web discovery
QSTASH_TOKEN=                         # durable queue (else in-process fan-out)
WEBHOOK_SECRET=                       # commerce webhook token (falls back to CRON_SECRET)

# Hero images for published articles (optional; articles publish text-only without it).
# OpenAI-compatible /images endpoint — set the key to enable. Any compatible host works.
IMAGE_API_KEY=                        # e.g. OpenAI (gpt-image-1). Enables article hero images.
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
# IMAGEN_MODEL=imagen-3.0-generate-002  # fallback via your free GEMINI_API_KEY (best-effort)

# Instant indexing (IndexNow) — free, no account. Published Genie Pages get indexed
# by Bing/Yandex in hours (which also feeds ChatGPT/Perplexity search). Generate any
# 16–32 char hex string (e.g. `openssl rand -hex 16`) and paste it here.
INDEXNOW_KEY=
